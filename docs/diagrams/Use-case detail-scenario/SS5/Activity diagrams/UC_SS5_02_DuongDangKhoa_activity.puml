
@startuml UC_SS5_02_DuongDangKhoa_activity
!include ../../../common.puml
skinparam activityMessageAlign center
skinparam activity {
  MaximumWidth 220
}
skinparam nodesep 20
skinparam ranksep 25

title Activity Diagram - UC_SS5_02: Giám sát hàng đợi sạc & Phí chiếm dụng Overstay

|Chuyên viên vận hành sạc|
start
:Mở chức năng giám sát;

|UI Layer|
:Hiển thị Dashboard;

|Control & State|
:Lấy danh sách xe và cổng sạc;

|IoT|
:Cập nhật SoC và trạng thái cổng sạc;

|Control & State|
if (Dữ liệu hợp lệ?) then ([Có])
  :Cập nhật trạng thái;
else ([Không])
  |UI Layer|
  :Thông báo lỗi kết nối IoT;
  stop
endif

|Control & State|
if (SoC >= 90%?) then ([Có])
  |Hệ thống thông báo|
  :Gửi cảnh báo sạc gần đầy;
else ([Không])
endif

|Control & State|
if (SoC = 100%?) then ([Có])
  |Hệ thống thông báo|
  :Gửi thông báo sạc hoàn tất;
  :Gửi biên nhận năng lượng;

  |Control & State|
  :Bắt đầu thời gian ân hạn 15 phút;

  if (Xe rời cổng trong 15 phút?) then ([Có])
    :Giải phóng cổng sạc;
    :Cập nhật trạng thái AVAILABLE;
  else ([Không])
    :Kiểm tra thời gian chiếm cổng;

    if (Hết thời gian ân hạn?) then ([Có])
      |Tài khoản & Ví điện tử|
      if (Ví đủ số dư?) then ([Có])
        :Khấu trừ phí Overstay Fee;
      else ([Không])
        :Ghi nhận khoản nợ ví;
      endif

      |Hệ thống thông báo|
      :Gửi cảnh báo Overstay;

      |Control & State|
      :Đánh dấu xe Overstay;
    else ([Không])
      :Tiếp tục theo dõi thời gian;
    endif
  endif
else ([Không])
  :Tiếp tục giám sát sạc;
endif

|UI Layer|
:Cập nhật Dashboard;
stop

@enduml
