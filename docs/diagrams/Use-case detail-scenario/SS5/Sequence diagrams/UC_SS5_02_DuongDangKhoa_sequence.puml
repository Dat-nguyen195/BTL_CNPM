
@startuml UC_SS5_02_DuongDangKhoa_sequence
!include ../../../common.puml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "Detailed UML Sequence Diagram: SS5 - Giám sát hàng đợi sạc & Phí chiếm dụng Overstay"

actor "Chuyên viên vận hành sạc\n(Operator)" as Operator

box "Boundary / UI Layer" #LightCyan
participant "smart_charging.py\n(UI)" as UI
end box

box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box

box "Hardware / IoT" #LightGray
participant "Cảm biến IoT\n(ChargingIoT)" as IoT
end box

box "Notification System" #White
participant "Hệ thống thông báo\n(Notification)" as Notification
end box

box "External Payment" #White
participant "Ví điện tử\n(E-Wallet)" as EWallet
end box

autonumber 1.1
group 1. Giám sát trạng thái sạc
    Operator -> UI: Mở chức năng giám sát hàng đợi sạc
    activate UI

    UI -> AppState: Lấy danh sách xe, hàng đợi\nvà trạng thái cổng sạc
    activate AppState
    AppState --> UI: Trả về danh sách và trạng thái
    deactivate AppState

    UI -> IoT: Lấy SoC và trạng thái cổng sạc
    activate IoT
    IoT --> UI: Trả về dữ liệu cảm biến
    deactivate IoT

    alt Mất kết nối IoT / Dữ liệu không hợp lệ
        UI -> AppState: Ghi nhận trạng thái UNKNOWN
        activate AppState
        AppState --> UI: Xác nhận cập nhật
        deactivate AppState

        UI --> Operator: Thông báo lỗi kết nối IoT
    else Dữ liệu hợp lệ
        UI -> AppState: Cập nhật SoC và trạng thái cổng sạc
        activate AppState
        AppState --> UI: Xác nhận cập nhật
        deactivate AppState

        opt SoC >= 90%
            UI -> Notification: Gửi cảnh báo pin sắp đầy
            activate Notification
            Notification --> UI: Xác nhận gửi thông báo
            deactivate Notification
        end
    end
    deactivate UI
end

autonumber 2.1
group 2. Xử lý khi xe sạc đầy & Tính phí quá hạn (Overstay)
    Operator -> UI: Kiểm tra trạng thái xe sạc
    activate UI

    UI -> AppState: Lấy SoC xe đang sạc
    activate AppState
    AppState --> UI: Trả về SoC hiện tại
    deactivate AppState

    alt SoC = 100%
        UI -> Notification: Gửi thông báo sạc hoàn tất
        activate Notification
        Notification --> UI: Xác nhận gửi thông báo
        deactivate Notification

        UI -> Notification: Gửi biên nhận năng lượng và chi phí
        activate Notification
        Notification --> UI: Xác nhận gửi biên nhận
        deactivate Notification

        UI -> AppState: Bắt đầu thời gian ân hạn 15 phút
        activate AppState
        AppState --> UI: Xác nhận bắt đầu bộ đếm
        deactivate AppState

        alt Xe rời cổng trong 15 phút
            UI -> AppState: Cập nhật phiên sạc hoàn tất\nvà cổng = AVAILABLE
            activate AppState
            AppState --> UI: Xác nhận giải phóng cổng
            deactivate AppState

            UI --> Operator: Cập nhật trạng thái cổng sạc
        else Xe vẫn chiếm cổng sau 15 phút
            UI -> AppState: Ghi nhận trạng thái OVERSTAY
            activate AppState
            AppState --> UI: Xác nhận OVERSTAY
            deactivate AppState

            UI -> EWallet: Kiểm tra số dư và thu Overstay Fee
            activate EWallet

            alt Ví đủ số dư
                EWallet --> UI: Khấu trừ phí phạt thành công
            else Ví không đủ số dư
                EWallet --> UI: Không đủ số dư
                UI -> AppState: Ghi nhận khoản nợ ví
                activate AppState
                AppState --> UI: Xác nhận ghi nợ
                deactivate AppState
            end
            deactivate EWallet

            UI -> Notification: Gửi cảnh báo Overstay Fee
            activate Notification
            Notification --> UI: Xác nhận gửi cảnh báo
            deactivate Notification

            UI --> Operator: Hiển thị danh sách xe Overstay
        end
    else SoC < 100%
        UI -> AppState: Tiếp tục theo dõi phiên sạc
        activate AppState
        AppState --> UI: Trả về trạng thái hiện tại
        deactivate AppState

        UI --> Operator: Cập nhật Dashboard
    end

    deactivate UI
end

@enduml
