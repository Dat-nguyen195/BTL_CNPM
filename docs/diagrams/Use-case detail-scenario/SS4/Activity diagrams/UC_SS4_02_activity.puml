@startuml UC_SS4_02_activity
!include ../../../common.puml
title UC_SS4_02 - Báo cáo sự cố phương tiện (Sơ đồ hoạt động)

|Nhân viên vận hành / Kỹ thuật viên|
start
:Phát hiện xe bất thường hoặc nhận tin báo từ sinh viên;
:Mở tab "Báo cáo sự cố" (SS4);
:Chọn Hub xảy ra sự cố;

|Hệ thống|
:Tải danh sách xe hiện có tại Hub đã chọn;

if (Hub có phương tiện?) then ([không])
  :Hiển thị "Không có xe tại Hub này";
  :Vô hiệu hóa nút "Gửi báo cáo sự cố";
  |Nhân viên vận hành / Kỹ thuật viên|
  stop
else ([có])
endif

|Nhân viên vận hành / Kỹ thuật viên|
:Chọn xe gặp sự cố (mã xe, loại xe);
:Chọn loại sự cố;
note right
  Xe hết pin | Va chạm | Hư hỏng kỹ thuật |
  Lỗi cổng sạc | Xe mất tích / Bị lấy trộm
end note
:Chọn mức độ nghiêm trọng\n(Thấp / Trung bình / Cao / Khẩn cấp);
:Nhập ghi chú chi tiết;
:Nhấn "Gửi báo cáo sự cố";

|Hệ thống|
:Tìm xe theo mã trong st.session_state["hubs"];
:Đặt trạng thái xe = INCIDENT\n(khóa phương tiện);
:Lưu bản ghi vào st.session_state["incident_log"]\n(thời gian, Hub, mã xe, loại sự cố, mức độ, ghi chú);
:Hiển thị "Đã ghi nhận sự cố xe [ID] tại Hub [Tên Hub]";

if (Mức độ Cao hoặc Khẩn cấp?) then ([có])
  :Hiển thị cảnh báo đỏ\nyêu cầu kỹ thuật xử lý khẩn cấp;
else ([không])
endif

:Ẩn xe khỏi danh sách xe khả dụng ở SS1\n(sinh viên không thể đặt);

|Nhân viên vận hành / Kỹ thuật viên|
if (Xem lịch sử sự cố?) then ([có])
  :Mở tab "Nhật ký";
  |Hệ thống|
  :Hiển thị danh sách nhật ký sự cố;
else ([không])
endif

|Nhân viên vận hành / Kỹ thuật viên|
stop
@enduml
