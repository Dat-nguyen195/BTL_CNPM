@startuml UC_SS4_02_statechart
!include ../../../common.puml
title UC_SS4_02 - Vòng đời trạng thái phương tiện khi có sự cố (Sơ đồ trạng thái)


[*] --> AVAILABLE : xe được đăng ký tại Hub

AVAILABLE : sẵn sàng cho thuê (SS1)
DISPATCHED : đã chuyển đến Hub đích (UC_SS4_01)

AVAILABLE --> DISPATCHED : thực hiện lệnh điều phối
AVAILABLE --> INCIDENT : báo cáo sự cố\n[xe có trong danh sách của Hub]
DISPATCHED --> INCIDENT : báo cáo sự cố\n[xe có trong danh sách của Hub]

state INCIDENT {
  state "Đã ghi nhận" as GhiNhan
  state "Mức thường" as Thuong
  state "Mức nghiêm trọng" as NghiemTrong
  [*] --> GhiNhan : ghi incident_log
  GhiNhan --> Thuong : mức độ Thấp / Trung bình
  GhiNhan --> NghiemTrong : mức độ Cao / Khẩn cấp
  NghiemTrong : hiển thị cảnh báo đỏ,\nkỹ thuật xử lý khẩn cấp
  Thuong : theo dõi trong nhật ký sự cố
}
INCIDENT : bị khóa - ẩn khỏi SS1,\nsinh viên không thể đặt

INCIDENT --> AVAILABLE : đã sửa chữa / xử lý xong\n(giả định - ngoài phạm vi use-case)
INCIDENT --> [*] : xe mất / bị trộm / thanh lý\n(giả định)

note right of INCIDENT
  Loại sự cố: Xe hết pin, Va chạm,
  Hư hỏng kỹ thuật, Lỗi cổng sạc,
  Xe mất tích / Bị lấy trộm
end note
@enduml
