@startuml UC_SS7_01_NguyenTrungNguyen_activity
!include ../../../common.puml
skinparam activityMessageAlign center

title Activity Diagram - UC_SS7_01: Mô phỏng sự cố mất điện / lỗi cổng sạc đột ngột

|Kỹ thuật viên / Điều phối viên|
start
:Chọn Hub mục tiêu & cấu hình số cổng lỗi\ntrên giao diện SS7;
:Nhấn "Chạy mô phỏng Port Failure";

|UI Layer (sim_infrastructure.py)|
:Khởi tạo HubEventSimulator\n& gửi yêu cầu mô phỏng;

|Core Simulator (simulator.py)|
:Tạo bản sao deepcopy(hubs)\n& giảm số cổng sạc khả dụng;
:Chuyển các xe đang CHARGING sang WAITING,\nngắt rơ-le bảo vệ pin & miễn phí chờ sạc;

if (Số cổng khả dụng == 0?) then ([Mất điện toàn trạm])
  :Đổi trạng thái Hub = OFFLINE\n& phát cảnh báo nguy cấp;
else ([Hỏng cục bộ một số cổng])
  :Đổi trạng thái cổng lỗi = ERROR;
endif

:Quét các Hub lân cận còn cổng sạc trống\n& lập danh sách Đề xuất điều phối;

|UI Layer (sim_infrastructure.py)|
:Hiển thị Event Log & Bảng đề xuất điều phối;

|Kỹ thuật viên / Điều phối viên|
if (Xác nhận áp dụng kết quả?) then ([Chỉ xem thử nghiệm])
  :Giữ nguyên dữ liệu vận hành gốc;
  stop
else ([Nhấn "Áp dụng kết quả mô phỏng"])
  |Ctrl&State (st.session_state)|
  :Cập nhật st.session_state["hubs"]\n& ghi nhận vào infra_log;
  
  |Phân hệ Đặt xe & Sạc (SS1 & SS2)|
  :Khóa nhận đặt chỗ/sạc mới tại Hub lỗi;
  if (Có giao dịch đang trả xe/thanh toán?) then ([Có])
    :Kích hoạt Local Offline Caching\n(Đóng băng công tơ & chờ có điện quyết toán);
  else ([Không])
  endif
  
  |Giám sát & Sự cố (SS3 & SS4)|
  :Đẩy cảnh báo đỏ lên Dashboard SS3\n& ghi nhận sự cố kỹ thuật vào SS4;
  
  |UI Layer (sim_infrastructure.py)|
  :Thông báo đồng bộ toàn hệ thống thành công;
  stop
endif

@enduml
