@startuml UC_SS2_01_NguyenAnhTai_activity
!include ../../../common.puml
skinparam activityMessageAlign center

title Activity Diagram - UC_SS2_01: Đăng ký xe EV cá nhân

|Sinh viên ĐHQG-HCM|
start
:Mở ứng dụng;

|UI Layer (personal_ev.py)|
:Xác thực phiên làm việc qua VNU-SSO;

|Control & State (st.session_state)|
:Kiểm tra current_user\nvà phân quyền student;

if (Tài khoản hợp lệ và có vai trò student?) then ([Không])
  |UI Layer (personal_ev.py)|
 :Yêu cầu đăng nhập bằng tài khoản\nsinh viên hợp lệ;
  stop
else ([Có])
  |Sinh viên ĐHQG-HCM|
 :Chọn Đăng ký xe cá nhân;
endif

|UI Layer (personal_ev.py)|
:Hiển thị biểu mẫu đăng ký;

repeat
  |Sinh viên ĐHQG-HCM|
 :Nhập họ tên, MSSV, biển số,\nloại xe, dung lượng pin;\nhãng/model nếu có;
  :Xác nhận đăng ký;

  |UI Layer (personal_ev.py)|
 :Kiểm tra tính đầy đủ và hợp lệ;

  if (Có sự cố hệ thống / mất kết nối?) then ([Có])
    |Control & State (st.session_state)|
   :Tạm dừng giao dịch;\nlưu đệm cục bộ khi còn khả năng ghi;
    |UI Layer (personal_ev.py)|
   :Thông báo bảo trì hoặc gián đoạn;\nyêu cầu thử lại sau;
    stop
  else ([Không])
  endif

  if (Thông tin hợp lệ?) then ([Không])
    :Chỉ rõ thông tin thiếu hoặc sai;\nyêu cầu điều chỉnh;
  else ([Có])
  endif
repeat while (Cần điều chỉnh thông tin?) is ([Có]) not ([Không])

|Control & State (st.session_state)|
:Tra cứu biển số xe;

if (Xe đã thuộc tài khoản hiện tại?) then ([Có])
  |UI Layer (personal_ev.py)|
 :Hiển thị hồ sơ hiện có;\nkhông tạo hồ sơ trùng;
  stop
else ([Không])
  |Control & State (st.session_state)|
  if (Biển số thuộc tài khoản khác?) then ([Có])
    |UI Layer (personal_ev.py)|
   :Từ chối đăng ký;\nhướng dẫn liên hệ hỗ trợ;
    stop
  else ([Không])
  endif
endif

|Control & State (st.session_state)|
:Cấp mã xe, ghi thời điểm đăng ký;\nlưu hồ sơ liên kết với sinh viên\nở trạng thái REGISTERED;

if (Lưu hồ sơ thành công?) then ([Không])
  :Tạm dừng giao dịch lỗi;\nbảo lưu dữ liệu đệm còn khả dụng;
  |UI Layer (personal_ev.py)|
 :Thông báo gián đoạn;\nyêu cầu thử lại sau;
  stop
else ([Có])
  |UI Layer (personal_ev.py)|
 :Thông báo đăng ký thành công;\nhiển thị thông tin xe;
endif

stop
@enduml

