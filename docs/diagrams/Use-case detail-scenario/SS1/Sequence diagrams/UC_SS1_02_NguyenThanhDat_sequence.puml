@startuml UC_SS1_02_NguyenThanhDat_sequence
!include ../../../common.puml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "Detailed UML Sequence Diagram: SS1 - Trả xe 1-chiều & Quyết toán ví điện tử"

actor "Sinh viên ĐHQG-HCM" as Student
box "Boundary / UI Layer" #LightCyan
participant "student_booking.py\n(UI)" as UI
end box
box "External Authentication" #White
participant "Cổng VNU-SSO\n(SSO)" as SSO
end box
box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box
box "External Payment" #White
participant "Ví điện tử\n(E-Wallet)" as EWallet
end box
box "Hardware / IoT" #LightGray
participant "Khóa IoT\n(SmartLock_IoT)" as SmartLock
end box

autonumber 1.1
group 1. Kiểm tra Hub đích & Trả xe
    Student -> UI: Di chuyển đến Hub đích & bấm "Trả xe"
    activate UI
    
    UI -> AppState: Kiểm tra chỗ đã giữ hoặc chỗ trống tại Hub trả
    AppState --> UI: Kết quả kiểm tra khả năng tiếp nhận
    alt Hub chưa tiếp nhận được
        UI -> UI: Trigger gọi ngầm UC_SS7_02:\nĐề xuất điều hướng 1-chạm\nsang Hub lân cận
        note right of UI
            - Bảo toàn cọc
            - Tặng 15p di chuyển miễn phí
        end note
        UI --> Student: Hiển thị gợi ý Hub lân cận
        Student -> UI: Chọn Hub thay thế
        UI -> AppState: Chuyển giữ chỗ; bảo toàn cọc;\ncộng 15 phút miễn phí một lần
        AppState --> UI: Kết quả chuyển giữ chỗ
        break Chưa chọn được Hub hợp lệ
            UI --> Student: Chưa hoàn tất trả xe; chuyến đi vẫn IN_USE
        end
        UI -> AppState: Kiểm tra lại Hub thay thế trước khi trả
        AppState --> UI: Hub sẵn sàng tiếp nhận
    else Hub có chỗ đã giữ hoặc còn chỗ trống
        UI -> UI: Tiếp tục quy trình trả xe
    end
        UI -> SmartLock: Gửi tín hiệu khóa xe (mô phỏng)
        activate SmartLock
        SmartLock --> UI: Xác nhận đã khóa chốt (mô phỏng)
        deactivate SmartLock
end

autonumber 2.1
group 2. Tính cước & Bồi hoàn cọc
    UI -> UI: Tính toán thời gian di chuyển\n(Miễn phí 30p đầu theo chính sách SV)
    
    UI -> EWallet: Gửi yêu cầu quyết toán chuyến đi
    activate EWallet
    EWallet --> UI: Quyết toán 50.000 VNĐ từ held_deposit;\nhoàn dư / thu thêm từ balance / ghi debt
    deactivate EWallet
    
    UI -> AppState: Lưu hóa đơn trong phiên
end

autonumber 3.1
group 3. Cập nhật Trạng thái
    UI -> AppState: Chuyển xe tới Hub trả;\ntiêu thụ chỗ giữ hoặc giảm available_slots;\nxe = AVAILABLE / CHARGING; booking = COMPLETED
    activate AppState
    AppState --> UI: Cập nhật hoàn tất
    deactivate AppState
    UI --> Student: Hiển thị hóa đơn chuyến đi
    deactivate UI
end

@enduml
