@startuml UC_SS1_03_NguyenThanhDat_sequence
!include ../../../common.puml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "Detailed UML Sequence Diagram: SS1 - Hủy đặt xe & Hoàn 100% cọc"

actor "Sinh viên ĐHQG-HCM" as Student
box "Boundary / UI Layer" #LightCyan
participant "student_booking.py\n(UI)" as UI
end box
box "External Authentication" #White
participant "Cổng VNU-SSO\n(SSO)" as SSO
end box
box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box
box "External Payment" #White
participant "Ví điện tử\n(E-Wallet)" as EWallet
end box
box "Hardware / IoT" #LightGray
participant "Khóa IoT\n(SmartLock_IoT)" as SmartLock
end box

autonumber 1.1
group 1. Yêu cầu Hủy
    Student -> UI: Chọn "Hủy đặt xe"\n(Trong hạn 30p giữ chỗ)
    activate UI
    
    UI -> AppState: Kiểm tra Timer đếm ngược
    activate AppState
    AppState --> UI: Hợp lệ (còn hạn)
    deactivate AppState
end

autonumber 2.1
group 2. Xử lý Hoàn cọc (Theo quy tắc D1)
    alt Sinh viên chủ động hủy trong 30 phút
        UI -> EWallet: Hoàn trả 100% cọc (50,000 VNĐ)\ntừ held_deposit về balance
        activate EWallet
        EWallet --> UI: Xác nhận hoàn 50,000 VNĐ
        deactivate EWallet
        
        UI -> AppState: Chuyển trạng thái xe:\nRESERVED -> AVAILABLE
        activate AppState
        AppState --> UI: Cập nhật hoàn tất
        deactivate AppState
        
        UI --> Student: Thông báo hủy thành công &\nHoàn 100% cọc (50,000 VNĐ)
    else Hết 30 phút không nhận xe (Tự động hủy - No-show)
        AppState -> EWallet: Khấu trừ phí phạt No-show (10,000 VNĐ),\nhoàn 40,000 VNĐ về balance
        activate EWallet
        EWallet --> AppState: Xác nhận hoàn 40,000 VNĐ
        deactivate EWallet
        
        AppState -> AppState: Chuyển trạng thái xe:\nRESERVED -> AVAILABLE
        AppState --> UI: Tự động hủy do No-show
        UI --> Student: Thông báo tự hủy do quá hạn 30p &\nKhấu trừ 10,000 VNĐ, hoàn 40,000 VNĐ
    end
    deactivate UI
end

@enduml
