@startuml UC_SS1_01_NguyenThanhDat_activity
!include ../../../common.puml
skinparam activityMessageAlign center

title Activity Diagram - UC_SS1_01: Đặt giữ chỗ & Quét QR/PIN nhận xe

|Sinh viên|
start
:Chọn Hub & Xe cần thuê;

|Giao diện SS1|
:Kiểm tra xác thực VNU-SSO;

|Trạng thái phiên|
:Đọc danh sách xe\n(AVAILABLE, SoC >= 20%);

|Giao diện SS1|
if (Số dư ví >= 50,000 VNĐ?) then ([Không đủ])
  :Báo lỗi "Số dư không đủ"\n& chuyển hướng sang Nạp tiền;
  stop
else ([Đủ])
  |Ví điện tử|
:Khóa 50.000 VNĐ cọc\nvào held_deposit;
  
  |Trạng thái phiên|
  :Đổi xe sang RESERVED\n& Kích hoạt Timer 30p;
  
  |Giao diện SS1|
  :Xuất mã QR/PIN & đếm ngược;
endif

|Sinh viên|
:Đến Hub quét QR/PIN\nnhận xe;

|Giao diện SS1|
:Đối chiếu mã & đếm ngược;
if (Thời gian giữ chỗ?) then ([Đã đủ 30p - No-show])
  |Ví điện tử|
  :Phạt 10,000 VNĐ, hoàn 40,000 VNĐ\nvề balance;
  
  |Trạng thái phiên|
  :Đổi xe = AVAILABLE;
  
  |Giao diện SS1|
  :Báo hết hạn;
  stop
else ([Hợp lệ < 30p])
  |Giao diện SS1|
  :Gửi lệnh mở khóa sang Khóa IoT;
  
  |IoT (mô phỏng)|
  :Mở chốt an toàn;
  
  fork
    |Trạng thái phiên|
    :Xe / Booking = IN_USE;\nghi giờ nhận, giải phóng\n1 chỗ tại Hub xuất phát;
  fork again
    |Giao diện SS1|
    :Hiển thị màn hình\n'Đang di chuyển';
  end fork
  
  stop
endif

@enduml
