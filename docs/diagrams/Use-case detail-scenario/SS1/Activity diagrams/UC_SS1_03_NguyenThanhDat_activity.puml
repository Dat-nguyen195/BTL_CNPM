@startuml UC_SS1_03_NguyenThanhDat_activity
!include ../../../common.puml
skinparam activityMessageAlign center

title Activity Diagram - UC_SS1_03: Hủy đặt xe & Hoàn 100% tiền cọc

|Sinh viên|
start
:Bấm "Hủy giữ chỗ"\ntrên ứng dụng;

|Giao diện SS1|
:Kiểm tra thời gian đếm ngược;

if (Đã đến hạn 30 phút?) then ([Đã đủ 30p - No-show])
  |Ví điện tử|
  :Khấu trừ phạt No-show 10,000 VNĐ,\nhoàn 40,000 VNĐ về balance;
  
  |Trạng thái phiên|
  :Xe = AVAILABLE;\nBooking = EXPIRED;\ngiải phóng chỗ đích đã giữ;
  
  |Giao diện SS1|
  :Thông báo tự hủy do quá hạn 30p\n(Phạt 10.000đ, hoàn 40.000đ);
else ([Chưa đủ 30p - Hủy chủ động])
  |Ví điện tử|
  :Giải phóng 100% cọc 50,000 VNĐ\ntừ held_deposit trở về\nbalance khả dụng;
  
  |Trạng thái phiên|
  :Xe = AVAILABLE;\nBooking = CANCELLED;\ngiải phóng chỗ đích đã giữ;
  
  |Giao diện SS1|
  :Hiển thị thông báo hủy thành công\nkèm hoàn 100% cọc (50.000đ);
endif
stop

@enduml
