@startuml UC_SS1_02_NguyenThanhDat_activity
!include ../../../common.puml
skinparam activityMessageAlign center

title Activity Diagram - UC_SS1_02: Trả xe 1-chiều & Quyết toán ví điện tử

|Sinh viên|
start
:Di chuyển xe đến Hub đích đã chọn\n& chọn "Trả xe";

|Giao diện SS1|
:Kiểm tra Hub: có chỗ đã giữ\nhoặc còn chỗ trống hợp lệ;
while (Cần đổi Hub?) is ([Có])
  :UC_SS7_02: Gợi ý 2 Hub lân cận;
  |Sinh viên|
  :Chọn Hub thay thế\nhoặc tiếp tục chuyến đi;
  if (Chọn được Hub?) then ([Không])
    |Giao diện SS1|
    :Thông báo chưa thể trả xe;\ngiữ chuyến đi IN_USE;
    stop
  else ([Có])
  endif
  |Trạng thái phiên|
  :Chuyển giữ chỗ sang Hub mới;\nbảo toàn cọc, thêm 15 phút\nmiễn phí một lần;
  |Sinh viên|
  :Di chuyển đến Hub mới;
  |Giao diện SS1|
  :Kiểm tra lại khả năng tiếp nhận;
endwhile ([Không])

|Giao diện SS1|
:Gửi tín hiệu chốt khóa an toàn;

|IoT (mô phỏng)|
:Xác nhận chốt khóa (mô phỏng);

|Giao diện SS1|
:Tính phí theo thời gian mô phỏng;\nmiễn 30 phút + ưu đãi điều hướng;

|Ví điện tử|
:Quyết toán cọc 50.000 VNĐ;\nhoàn dư / thu thêm / ghi nợ;

|Trạng thái phiên|
if (Có chỗ đã giữ tại Hub trả?) then ([Có])
  :destination_holds -= 1;\nkhông trừ chỗ trống lần hai;
else ([Không])
  :Giải phóng giữ chỗ cũ nếu có;\navailable_slots -= 1 tại Hub trả;
endif
:Chuyển xe tới Hub trả;
if (SoC < 20%?) then ([Có])
  :Xe = CHARGING;
else ([Không])
  :Xe = AVAILABLE;
endif
:Booking = COMPLETED;\nlưu hóa đơn trong phiên;

|Giao diện SS1|
:Hiển thị hóa đơn chuyến đi;

|Sinh viên|
:Xem biên lai chuyến đi & rời trạm;
stop

@enduml
