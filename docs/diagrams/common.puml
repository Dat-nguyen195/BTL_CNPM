!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.2
skinparam BoxPadding 10
skinparam LifelineBorderColor #34495E
skinparam LifelineBackgroundColor #ECF0F1

skinparam sequence {
    ActorBorderColor #2980B9
    ActorBackgroundColor #EBF5FB
    ParticipantBorderColor #2C3E50
    ParticipantBackgroundColor #F8F9FA
    GroupHeaderFontColor #2C3E50
    GroupBorderColor #BDC3C7
    GroupBackgroundColor #FAFAFA
    DividerBorderColor #BDC3C7
}

skinparam activity {
    StartColor #2C3E50
    EndColor #2C3E50
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BarColor #2C3E50
    DiamondBackgroundColor #FFFFFF
    DiamondBorderColor #2C3E50
}

' UML decision/merge nodes use diamonds; avoid the hexagonal plain-theme style.
skinparam conditionStyle insideDiamond
skinparam conditionEndStyle diamond
skinparam activityMessageAlign center

' The plain theme otherwise leaves the centre of the activity-final node white.
<style>
activityDiagram {
    circle {
        start, stop, end {
            BackgroundColor #2C3E50
            LineColor #2C3E50
        }
    }
}
stateDiagram {
    circle {
        start, stop, end {
            BackgroundColor #2C3E50
            LineColor #2C3E50
        }
    }
}
</style>

skinparam state {
    StartColor #2C3E50
    EndColor #2C3E50
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
}
