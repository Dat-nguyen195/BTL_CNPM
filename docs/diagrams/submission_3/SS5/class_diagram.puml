
@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam classAttributeIconSize 0
skinparam linetype ortho

title Class Diagram SS5 - Smart Charging Scheduler

legend right
  |= Stereotype |= Meaning |
  | <<Implemented>> | Exists in original source code |
  | <<Required - Not Implemented>> | Required by design/interface, absent from original code |
  | <<External>> | Owned by another subsystem |
endlegend

package "SS5 - Smart Charging" {

    class ChargingRequest <<Implemented>> {
        +vehicle_id: str
        +hub_id: str
        +battery_soc: float
        +has_student_booking: bool
        +requested_at: datetime
        +priority_score: float
        +ownership: str
        +owner_id: Optional[str]
        +target_soc: float
        +port_kw: float
        --
        +__post_init__(): None
        +__repr__(): str
    }

    class ChargingSession <<Implemented>> {
        +session_id: str
        +vehicle_id: str
        +hub_id: str
        +port_id: str
        +port_kw: float
        +current_soc: float
        +target_soc: float
        +status: str
        +started_at: datetime
        +completed_at: Optional[datetime]
        +alert_90_sent: bool
        +grace_deadline: Optional[datetime]
        +overstay_minutes: int
        +overstay_fee: int
        +energy_delivered_kwh: float
    }

    class SmartChargingScheduler <<Implemented>> {
        -cap_kw: float
        -_queue: List[ChargingRequest]
        -_active_sessions: Dict[str, ChargingSession]
        --
        +__init__(cap_kw: float = HUB_POWER_CAP_KW): None
        {static} +calculate_priority(request: ChargingRequest): float
        +add_request(request: ChargingRequest): None
        +remove_request(vehicle_id: str): Optional[ChargingRequest]
        +get_sorted_queue(): List[ChargingRequest]
        +allocate_ports(hub_id: str, available_port_count: int,\n current_active_kw: float = 0.0): List[Dict]
        +advance_simulation_tick(minutes: int = 15): List[Dict]
        +unplug_vehicle(session_id: str): Optional[ChargingSession]
        +queue_length: int
        +get_queue_as_dicts(): list
    }

    class ChargingService <<Required - Not Implemented>> {
        +request_charging(owner_id: str, vehicle_id: str, hub_id: str,\n current_soc: float, target_soc: float = 100.0,\n reservation_id: Optional[str] = None): OperationResult[ChargingRequestResult]
        +get_bill(session_id: str): OperationResult[ChargingBill]
        +handle_port_failure(hub_id: str, port_ids: list[str],\n operation_key: str): OperationResult[PortFailureResult]
    }

    class ChargingRequestResult <<Required - Not Implemented>> {
        +request_id: str
        +vehicle_id: str
        +hub_id: str
        +status: ChargingStatus
        +session_id: Optional[str]
    }

    class ChargingPort <<Required - Not Implemented>> {
        +port_id: str
        +hub_id: str
        +status: PortStatus
        +max_power_kw: float
    }

    class ChargingBill <<Required - Not Implemented>> {
        +session_id: str
        +energy_delivered_kwh: float
        +energy_fee_vnd: int
        +overstay_fee_vnd: int
        +charge_lines: List[ChargeLine]
        +payment_status: str
        +collected_amount_vnd: int
    }

    class PortFailureResult <<Required - Not Implemented>> {
        +hub_id: str
        +affected_port_ids: List[str]
        +affected_session_ids: List[str]
        +remaining_capacity_kw: float
    }
}

package "Billing - Original billing.py" {

    class BillingFunctions <<implemented module>> {
        +settle_overstay_charging(wallet: Dict[str, Any],\n session_id: str, vehicle_id: str, overstay_fee: int, energy_fee: int=0,\n kwh_charged: float=0.0, sim_time: Optional[str]=None): Dict[str, Any]
        +calculate_private_ev_bill(parking_fee: int=PARKING_PER_VISIT_VND,\n kwh_consumed: float=0.0, checkin_time_str: Optional[str]=None,\n overstay_minutes: int=0): Dict[str, Any]
        +record_transaction(wallet: Dict[str, Any], tx_type: str,\n amount: int, booking_id: Optional[str]=None, note: str='',\n sim_time: Optional[str]=None): Dict[str, Any]
        +record_wallet_debt(wallet: Dict[str, Any], amount: int,\n reason: str='', sim_time: Optional[str]=None): None
    }
}

package "External Contracts" {

    class OperationResult <<External>> {
        +ok: bool
        +data: T
        +error_code: str
        +message: str
        +state_version: int
    }

    class ChargeLine <<External - TV1>> {
        +charge_id: str
        +source_id: str
        +kind: str
        +amount_vnd: int
    }

    class BillingService <<External - TV1>> {
        +settle_invoice(owner_id: str, reference_id: str,\n charge_lines: list[ChargeLine],\n operation_key: str): OperationResult[SettlementResult]
    }
}

SmartChargingScheduler "1" o-- "0..*" ChargingRequest : queue
SmartChargingScheduler "1" o-- "0..*" ChargingSession : active sessions

ChargingSession ..> ChargingPort : port_id reference

ChargingService ..> SmartChargingScheduler : uses
ChargingService ..> ChargingRequest : creates
ChargingService ..> ChargingRequestResult : returns
ChargingService ..> ChargingBill : returns
ChargingService ..> PortFailureResult : returns

ChargingBill "1" o-- "1..*" ChargeLine : contains
ChargingService ..> BillingService : submits fees
BillingService ..> ChargeLine : settles

BillingFunctions ..> ChargingSession : receives session data
BillingFunctions ..> ChargingBill : produces invoice data

note right of SmartChargingScheduler
  Original implementation: scheduler.py

  - Calculates priority score.
  - Maintains the waiting queue.
  - Allocates charging ports under Hub power cap.
  - Advances charging simulation.
  - Tracks grace period and overstay fees.
  - Unplugs vehicles and releases sessions.
end note

note bottom of ChargingService
  Required service interface from
  SS5 subsystem contract:

  INT-01: request_charging
  INT-02: get_bill
  INT-05: handle_port_failure

  These methods do not exist in
  the original source code.
end note

note bottom of BillingFunctions
  Original billing.py contains functions,
  not a BillingService class.

  settle_overstay_charging() directly
  modifies wallet balance and records debt.
end note

note bottom of ChargingPort
  Original scheduler.py stores port_id
  as a string in ChargingSession.

  It does not define a ChargingPort class
  or maintain a port object.
end note

@enduml
