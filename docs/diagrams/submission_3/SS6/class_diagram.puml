@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam nodesep 28
skinparam ranksep 32
title SS6 - thiết kế Sub3, revision 06/11/2026
class DemandScenario <<proposed model>> {
  +scenario_id: str
  +hub_id: str
  +num_students: int
  +seed: int
}
class ForecastPoint <<proposed model>> {
  +hour: str
  +arrivals: int
  +queue_length: int
  +wait_time_min: float
}
class ForecastResult <<proposed model>> {
  +forecast_id: str
  +hub_id: str
  +hours: int = 24
  +seed: int
  +assumptions: str
  +points: list[ForecastPoint]
}
class SimulationPreview <<proposed model>> {
  +preview_id: str
  +scenario_type: str
  +baseline_version: int
  +modified_hubs: list[dict]
  +charging_effects: list[dict]
  +summary: dict
  +is_applied: bool
  +target_hub_id: str
  +event_log: list[str]
}
class ApplyResult <<proposed model>> {
  +preview_id: str
  +applied: bool
  +already_applied: bool
  +new_state_version: int
}
class DemandSimulationService <<proposed service>> {
  +preview_demand(hub_id: str, num_students: int,\n seed: int = 42): OperationResult[SimulationPreview]
}
class ForecastService <<proposed service>> {
  +forecast(hub_id: str, base_arrival_rate: float,\n surge_multiplier: float, hours: int = 24,\n seed: int = 42): OperationResult[ForecastResult]
}
class SimulationCoordinator <<proposed service>> {
  +apply_preview(preview_id: str, expected_version: int): OperationResult[ApplyResult]
}
class HubEventSimulator <<implemented>> {
  +simulate_metro_surge(target_hub_id: str = "HUB-002",\n num_new_students: int = 20,\n seed: Optional[int] = 42): tuple[list[dict],list[str],dict]
  +generate_demand_forecast(base_arrival_rate: float = 10.0,\n surge_multiplier: float = 1.0, hours: int = 12,\n seed: Optional[int] = 42): list[dict]
}
ForecastResult "1" *-- "24" ForecastPoint
DemandSimulationService ..> DemandScenario
DemandSimulationService ..> SimulationPreview
ForecastService ..> ForecastResult
SimulationCoordinator ..> SimulationPreview
SimulationCoordinator ..> ApplyResult
DemandSimulationService ..> HubEventSimulator
ForecastService ..> HubEventSimulator
SimulationCoordinator ..> ChargingService : INT-05 khi PORT_FAILURE
class ChargingService <<shared TV5 proposed>>

legend bottom
  Proposed = thiết kế, chưa phải lớp đang chạy.
  Shared = tham chiếu chủ sở hữu; không định nghĩa lại.
  Tiền: VNĐ nguyên; SoC: %; năng lượng: kWh; công suất: kW.
  datetime thiết kế: UTC+7 theo đồng hồ mô phỏng.
endlegend
@enduml
