@startuml UC_SS2_04_NguyenAnhTai_sequence_p1
!include ../../../diagrams/common.puml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "UC_SS2_04_ - Phần 1/3: Xác thực phiên và lập hóa đơn"

' Nguồn: UC_SS2_NguyenAnhTai (2).md, cập nhật 21/09/2026.
' Thiết kế theo đặc tả; không khẳng định toàn bộ chức năng đã có trong mã nguồn.

actor "Sinh viên ĐHQG-HCM" as Student
box "Boundary / UI Layer" #LightCyan
participant "personal_ev.py\n(UI)" as UI
end box
box "External Authentication" #White
participant "Cổng VNU-SSO\n(SSO)" as SSO
end box
box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box
box "External Payment" #White
participant "Cổng thanh toán & Ví nội bộ\n(Payment / E-Wallet)" as EWallet
end box
box "Hardware / IoT" #LightGray
participant "Barie & Cảm biến cổng\n(Gate_IoT)" as Gate
participant "Trụ sạc\n(Charger_IoT)" as Charger
end box
box "Operations" #White
actor "Nhân viên vận hành\n(Operators)" as Operators
end box


note over UI, AppState #LightCyan
  Phần 1/3 - Nhóm nghiệp vụ: 1, 2
  Đọc theo thứ tự các phần; thông điệp giữ số của sơ đồ gốc.
end note
autonumber 1.1
group 1. Xác thực và xác định phiên sử dụng
    Student -> UI: Yêu cầu Check-out / Thanh toán
    activate UI
    UI -> SSO: Xác thực phiên sinh viên
    activate SSO
    SSO --> UI: Kết quả xác thực
    deactivate SSO
    UI --> Student: Kết quả xác thực phiên
    deactivate UI

    break Phiên đăng nhập không hợp lệ
        UI --> Student: Yêu cầu xác thực lại
    end

    UI -> AppState: Tra cứu xe, quyền sử dụng\nvà phiên đỗ đã CHECKED_IN
    activate AppState
    AppState --> UI: Phiên sử dụng / lý do không hợp lệ
    deactivate AppState

    break Không có phiên hợp lệ hoặc không có quyền sử dụng
        UI --> Student: Từ chối xử lý;\nyêu cầu kiểm tra thông tin
    end
end

autonumber 2.1
group 2. Kết thúc sạc và lập hóa đơn tổng hợp
    alt Có sử dụng dịch vụ sạc
        UI -> Charger: Kết thúc sạc nếu còn hoạt động;\nchốt dữ liệu tiêu thụ theo khung giá
        activate Charger
        Charger -> Charger: Dừng sạc hoặc sử dụng số liệu đã chốt
        Charger --> UI: Kết quả dừng sạc và kWh theo khung giờ
        deactivate Charger

        break Chưa dừng được sạc hoặc thiếu dữ liệu chốt
            UI -> Operators: Yêu cầu xử lý / đối soát số đo
            UI --> Student: Chưa thể hoàn tất hóa đơn
        end

        UI -> AppState: Ghi nhận lượng điện và phí sạc thực tế\n7.000 VNĐ/kWh cao điểm; 3.000 VNĐ/kWh thấp điểm
        activate AppState
        AppState --> UI: Chi tiết phí sạc theo từng khung giờ
        deactivate AppState

    else Không sử dụng dịch vụ sạc
        UI -> AppState: Xác định hóa đơn chỉ gồm phí đỗ
        activate AppState
        AppState --> UI: Không phát sinh phí sạc
        deactivate AppState
    end

    UI -> AppState: Tính phí đỗ 5.000 VNĐ/lượt,\nphí sạc thực tế và voucher đã áp dụng nếu có
    activate AppState
    AppState -> AppState: Lập một hóa đơn tổng hợp
    AppState --> UI: Chi tiết hóa đơn và tổng số tiền phải trả
    deactivate AppState
    UI --> Student: Hiển thị hóa đơn phí đỗ + phí sạc

    note over UI, AppState
        Cao điểm: 06:00–09:00 và 16:00–19:30.
        Thời điểm chốt phí và thời hạn rời bãi sau thanh toán
        thực hiện theo chính sách dịch vụ.
    end note
end

@enduml
